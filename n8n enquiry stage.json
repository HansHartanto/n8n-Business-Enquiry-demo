      "parameters": {
        "jsCode": "const formData = $('On form submission').item.json;\nconst data = $json.output;\nconst required = ['product_type', 'quantity', 'finish', 'sides'];\nconst missing = required.filter(field => !data[field]);\n\nreturn [{\n  json: {\n    order_id: 'ORD-' + Date.now(),\n    name: formData['Name'],\n    email: formData['Email'],\n    deadline: formData['Deadline'],\n    has_artwork: formData['Have artwork already'],\n    raw_text: formData['Please let us know what you need.'],\n    submitted_at: formData['submittedAt'],\n    ...data,\n    is_complete: missing.length === 0,\n    missing_fields: missing\n  }\n}];"
      },
